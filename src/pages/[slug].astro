---
import DocsLayout from "../layouts/DocsLayout.astro";
import FeatureTable from "../components/FeatureTable.astro";
import FeatureTally from "../components/FeatureTally.astro";
import {
  getTools,
  getToolDetail,
  getAllSlugs,
  getSimilarTools,
  WORKFLOW_STAGE_FACETS,
  DETECTION_FACETS,
  AI_CAPABILITY_FACETS,
  COMPLIANCE_BOOL_FACETS,
  GIT_PROVIDER_FACETS,
  API_CLI_FACETS,
  BEST_FIT_BUYER_LABELS,
  PRICING_MODEL_LABELS,
} from "../lib/tools.js";
import { websiteFor } from "../data/tool-websites.js";
import { logoPathFor } from "../lib/logos.js";
import Shuffle from "../components/Shuffle.astro";
import FaqItems from "../components/FaqItems.astro";
import { faqJsonLd } from "../lib/faq.js";

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const tool = getToolDetail(slug);
const allTools = getTools();
// Every other tool in the category, alphabetically; the grid shows a shuffled
// four on each page load so no tool is always the one recommended.
const similar = getSimilarTools(tool, allTools, Infinity).sort((a, b) => a.name.localeCompare(b.name));
const officialSite = websiteFor(slug);

function ok(v) {
  return v === "yes" || v === "partial";
}
// Several free-text fields (best_fit_team_size, minimum_seats, trial, plan price/who_for)
// fall back to the literal string "unknown" when a vendor doesn't document them — never
// render that raw, since it reads as a broken page rather than an honest gap.
function known(v) {
  if (!v) return false;
  if (typeof v === "string") return v.trim().toLowerCase() !== "unknown";
  return true;
}
// Never let a partial implementation read as full support in generated copy.
function mark(label, v) {
  if (v === "yes") return label;
  if (v === "partial") return `${label} (partial)`;
  return null;
}
function joinList(arr, max = 8) {
  if (!arr || !arr.length) return "";
  const shown = arr.slice(0, max).join(", ");
  return arr.length > max ? `${shown}, and ${arr.length - max} more` : shown;
}

const langCount = (typeof tool.languages?.count_claimed === "number" ? tool.languages.count_claimed : 0) || tool.languages?.list?.length || 0;
const languageList = tool.languages?.list || [];
const gatedLanguages = tool.languages?.tier_gated_languages || [];
const buyerLabels = (tool.fit_signals?.best_fit_buyer || []).map((b) => BEST_FIT_BUYER_LABELS[b] || b);
const gitLabels = GIT_PROVIDER_FACETS.map((f) =>
  mark(f.label, tool.integrations?.git_providers?.[f.key])
).filter(Boolean);

// Split into short paragraphs and lists (see src/lib/faq.js) so no answer is
// one long block of text.
const sentence = (t) => {
  const x = String(t).trim();
  return x ? x.charAt(0).toUpperCase() + x.slice(1) + (/[.!?]$/.test(x) ? "" : ".") : "";
};
const lowerFirst = (t) => t.charAt(0).toLowerCase() + t.slice(1);
const hasPublishedPrice = /^\$/.test(tool.priceLabel);
const integrationItems = [
  gitLabels.length && `Source control: ${joinList(gitLabels, 7)}`,
  tool.integrations?.ci_systems?.length && `CI systems: ${joinList(tool.integrations.ci_systems, 5)}`,
  tool.integrations?.ides?.length && `IDEs: ${joinList(tool.integrations.ides, 5)}`,
].filter(Boolean);

const faqs = [
  {
    q: `When should you choose ${tool.name}?`,
    a: [
      `${tool.name} best fits ${buyerLabels.length ? joinList(buyerLabels.map(lowerFirst), 5) : "teams evaluating this category"}.`,
      ...(known(tool.fit_signals?.best_fit_team_size) ? [sentence(tool.fit_signals.best_fit_team_size)] : []),
      ...(tool.fit_signals?.notable_strengths?.[0] ? [sentence(tool.fit_signals.notable_strengths[0])] : []),
    ],
  },
  {
    q: `What languages does ${tool.name} support?`,
    a: langCount
      ? `${tool.name} supports ${langCount}+ languages and frameworks, including ${joinList(tool.languages.list, 10)}.`
      : `Language support for ${tool.name} is not documented in the sources reviewed.`,
  },
  {
    q: `What does ${tool.name} integrate with?`,
    a: integrationItems.length
      ? [`${tool.name} integrates with:`, { list: integrationItems }]
      : `See the integrations documented above.`,
  },
  {
    q: `What tools are similar to ${tool.name}?`,
    a: similar.length
      ? [`Other ${tool.categoryLabel} tools tracked here:`, { links: similar.map((s) => ({ text: s.name, href: `/${s.slug}/` })) }]
      : `No other tools in the ${tool.categoryLabel} category are currently tracked.`,
  },
  {
    q: `What are ${tool.name}'s plans and pricing?`,
    a: `${tool.name} ${tool.commercial?.free_tier?.v === "yes" ? "offers a free tier, with paid plans" : "has paid plans"} ${
      hasPublishedPrice ? `starting around ${tool.priceLabel}` : "priced by contacting the vendor"
    }${tool.commercial?.enterprise_quote_only?.v === "yes" ? ", and enterprise pricing is quote-only" : ""}.`,
  },
];

const hasFit = tool.fit_signals?.notable_strengths?.length > 0 || tool.fit_signals?.notable_limitations?.length > 0;
// "On this page" entries, built from the same conditions that render each section.
const toc = [
  { id: "workflow-heading", label: "Workflow coverage" },
  { id: "detection-heading", label: "Analysis & detection" },
  { id: "ai-heading", label: "AI capabilities" },
  { id: "compliance-heading", label: "Compliance & governance" },
  { id: "integrations-heading", label: "Integrations" },
  ...(languageList.length > 0 ? [{ id: "languages-heading", label: "Languages" }] : []),
  { id: "pricing-heading", label: "Pricing & plans" },
  ...(hasFit ? [{ id: "fit-heading", label: "Who it's for" }] : []),
  ...(similar.length > 0 ? [{ id: "similar-heading", label: "Similar tools" }] : []),
  { id: "faq-heading", label: "FAQ" },
];

const jsonLdApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: tool.name,
  description: tool.one_liner,
  applicationCategory: tool.categoryLabel,
  ...(tool.commercial?.free_tier?.v === "yes"
    ? { offers: { "@type": "Offer", price: "0", priceCurrency: "USD", description: "Free tier" } }
    : {}),
};
const jsonLdFaq = faqJsonLd(faqs, Astro.site);
---
<DocsLayout
  title={`${tool.name} — Review Radar`}
  description={tool.one_liner}
  breadcrumbs={[{ name: tool.name, url: `/${tool.slug}/` }]}
  nav="tools"
  current={tool.slug}
  toc={toc}
>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLdApp)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

    <header class="tool-hero">
      <p class="label section-label">{tool.categoryLabel}</p>
      <div class="tool-hero-title">
        <span class="tool-hero-avatar">
          {logoPathFor(tool.slug) ? <img src={logoPathFor(tool.slug)} alt="" loading="lazy" /> : tool.name.charAt(0).toUpperCase()}
        </span>
        <h1 class="h1">{tool.name}</h1>
      </div>
      <p class="tool-hero-lede">{tool.one_liner}</p>
      <p class="tool-hero-meta">{tool.priceLabel}<span aria-hidden="true">·</span>Last verified {tool.lastUpdated}</p>
    </header>

    <div class="quick-facts-grid">
      <div class="quick-fact">
        <p class="label quick-fact-label">Deployment</p>
        <p class="quick-fact-value">
          {[
            mark("Cloud", tool.deployment?.saas_cloud?.v),
            mark("Self-Hosted", tool.deployment?.self_hosted?.v),
            mark("Air-Gapped", tool.deployment?.air_gapped?.v),
          ].filter(Boolean).join(" · ") || "Not documented"}
        </p>
      </div>
      <div class="quick-fact">
        <p class="label quick-fact-label">Languages</p>
        <p class="quick-fact-value">{langCount ? `${langCount}+` : "Not documented"}</p>
      </div>
      <div class="quick-fact">
        <p class="label quick-fact-label">Pricing model</p>
        <p class="quick-fact-value">{(tool.commercial?.pricing_models || []).map((m) => PRICING_MODEL_LABELS[m] || m).join(", ") || "Not documented"}</p>
      </div>
      <div class="quick-fact">
        <p class="label quick-fact-label">Free tier</p>
        <p class="quick-fact-value">{tool.commercial?.free_tier?.v === "yes" ? "Yes" : tool.commercial?.free_tier?.v === "partial" ? "Partial" : "No"}</p>
      </div>
    </div>

    <section class="detail-section">
      <div class="detail-section-head has-tally">
        <div>
          <h2 class="h2" id="workflow-heading">Workflow coverage</h2>
          <p class="text-secondary" style="margin-top: var(--space-xs);">Where in the development lifecycle {tool.name} operates.</p>
        </div>
        <FeatureTally sets={[{ facets: WORKFLOW_STAGE_FACETS, cells: tool.workflow_stages }]} />
      </div>
      <FeatureTable facets={WORKFLOW_STAGE_FACETS} cells={tool.workflow_stages} glossaryType="workflow" labelledby="workflow-heading" />
    </section>

    <section class="detail-section">
      <div class="detail-section-head has-tally">
        <div>
          <h2 class="h2" id="detection-heading">Analysis &amp; detection</h2>
          <p class="text-secondary" style="margin-top: var(--space-xs);">Every detection and code-analysis capability tracked for {tool.name}.</p>
        </div>
        <FeatureTally sets={[{ facets: DETECTION_FACETS, cells: tool.detection }]} />
      </div>
      <FeatureTable facets={DETECTION_FACETS} cells={tool.detection} glossaryType="detection" labelledby="detection-heading" />
    </section>

    <section class="detail-section">
      <div class="detail-section-head has-tally">
        <h2 class="h2" id="ai-heading">AI capabilities</h2>
        <FeatureTally sets={[{ facets: AI_CAPABILITY_FACETS, cells: tool.ai_posture }]} />
      </div>
      <FeatureTable facets={AI_CAPABILITY_FACETS} cells={tool.ai_posture} glossaryType="ai" labelledby="ai-heading" />
      {tool.ai_posture?.models_used?.length > 0 && (
        <div style="margin-top: var(--space-lg);">
          <p class="label quick-fact-label" style="margin-bottom: var(--space-sm);">Models used</p>
          <div class="chip-list">
            {tool.ai_posture.models_used.map((m) => <span class="chip">{m}</span>)}
          </div>
        </div>
      )}
    </section>

    <section class="detail-section">
      <div class="detail-section-head has-tally">
        <h2 class="h2" id="compliance-heading">Compliance &amp; governance</h2>
        <FeatureTally sets={[{ facets: COMPLIANCE_BOOL_FACETS, cells: tool.compliance }]} />
      </div>
      <FeatureTable facets={COMPLIANCE_BOOL_FACETS} cells={tool.compliance} glossaryType="compliance" labelledby="compliance-heading" />
      {tool.compliance?.certifications?.length > 0 && (
        <div style="margin-top: var(--space-lg);">
          <p class="label quick-fact-label" style="margin-bottom: var(--space-sm);">Certifications</p>
          <div class="chip-list">
            {tool.compliance.certifications.map((c) => <span class="chip">{c}</span>)}
          </div>
        </div>
      )}
      {tool.compliance?.standards_mapping?.length > 0 && (
        <div style="margin-top: var(--space-lg);">
          <p class="label quick-fact-label" style="margin-bottom: var(--space-sm);">Standards mapping</p>
          <div class="chip-list">
            {tool.compliance.standards_mapping.map((c) => <span class="chip">{c}</span>)}
          </div>
        </div>
      )}
    </section>

    <section class="detail-section">
      <div class="detail-section-head has-tally">
        <h2 class="h2" id="integrations-heading">Integrations</h2>
        <FeatureTally sets={[
          { facets: GIT_PROVIDER_FACETS, cells: tool.integrations?.git_providers },
          { facets: API_CLI_FACETS, cells: tool.integrations?.api_cli },
        ]} />
      </div>
      <div class="feature-table-pair">
        <FeatureTable facets={GIT_PROVIDER_FACETS} cells={tool.integrations?.git_providers} labelledby="integrations-heading" firstColumn="Git provider" compact />
        <FeatureTable facets={API_CLI_FACETS} cells={tool.integrations?.api_cli} glossaryType="apiCli" labelledby="integrations-heading" firstColumn="API & CLI" compact />
      </div>
      {["ci_systems", "ides", "issue_trackers", "chat_notifications"].map((key) => {
        const labels = { ci_systems: "CI/CD systems", ides: "IDEs", issue_trackers: "Issue trackers", chat_notifications: "Chat & notifications" };
        const list = tool.integrations?.[key];
        return list?.length > 0 && (
          <div style="margin-top: var(--space-lg);">
            <p class="label quick-fact-label" style="margin-bottom: var(--space-sm);">{labels[key]}</p>
            <div class="chip-list">
              {list.map((v) => <span class="chip">{v}</span>)}
            </div>
          </div>
        );
      })}
    </section>

    {languageList.length > 0 && (
      <section class="detail-section">
        <div class="detail-section-head">
          <h2 class="h2" id="languages-heading">Languages</h2>
          <p class="text-secondary" style="margin-top: var(--space-xs);">Languages and frameworks named in {tool.name}'s documentation.</p>
        </div>
        <div class="chip-list">
          {languageList.map((l) => <span class="chip">{l}</span>)}
        </div>
        {gatedLanguages.length > 0 && (
          <p class="caption" style="margin-top: var(--space-md);">Need a higher plan: {gatedLanguages.join(", ")}</p>
        )}
      </section>
    )}

    <section class="detail-section">
      <div class="detail-section-head">
        <h2 class="h2" id="pricing-heading">Pricing &amp; plans</h2>
        {known(tool.commercial?.entry_paid_price) && (
          <p class="text-secondary" style="margin-top: var(--space-xs);">{tool.commercial.entry_paid_price}</p>
        )}
        {known(tool.commercial?.minimum_seats) && (
          <p class="caption" style="margin-top: var(--space-xs);">Minimum seats: {tool.commercial.minimum_seats}</p>
        )}
        {known(tool.commercial?.trial) && (
          <p class="caption" style="margin-top: var(--space-xs);">Trial: {typeof tool.commercial.trial === "string" ? tool.commercial.trial : tool.commercial.trial.note}</p>
        )}
      </div>
      {tool.commercial?.plans?.length > 0 && (
        <div class="plans-grid">
          {tool.commercial.plans.map((plan) => (
            <div class="plan-card">
              <span class="plan-name">{plan.name}</span>
              <span class="plan-price">{known(plan.price) ? plan.price : "Contact for pricing"}</span>
              {known(plan.who_for) && <span class="plan-who">{plan.who_for}</span>}
              {plan.key_inclusions?.length > 0 && (
                <ul class="plan-list">
                  {plan.key_inclusions.map((i) => <li>{i}</li>)}
                </ul>
              )}
              {plan.key_limits?.length > 0 && (
                <ul class="plan-list limits">
                  {plan.key_limits.map((i) => <li>{i}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    {hasFit && (
      <section class="detail-section">
        <div class="detail-section-head">
          <h2 class="h2" id="fit-heading">Who it's for</h2>
          {known(tool.fit_signals?.best_fit_team_size) && (
            <p class="text-secondary" style="margin-top: var(--space-xs);">{tool.fit_signals.best_fit_team_size}</p>
          )}
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-xl);">
          {tool.fit_signals?.notable_strengths?.length > 0 && (
            <div>
              <p class="label quick-fact-label" style="margin-bottom: var(--space-md);">Notable strengths</p>
              <ul class="fit-list strengths">
                {tool.fit_signals.notable_strengths.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          )}
          {tool.fit_signals?.notable_limitations?.length > 0 && (
            <div>
              <p class="label quick-fact-label" style="margin-bottom: var(--space-md);">Notable limitations</p>
              <ul class="fit-list limitations">
                {tool.fit_signals.notable_limitations.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {similar.length > 0 && (
      <section class="detail-section">
        <div class="detail-section-head">
          <h2 class="h2" id="similar-heading">Similar tools</h2>
          <p class="text-secondary" style="margin-top: var(--space-xs);">Other {tool.categoryLabel} tools in the directory.</p>
        </div>
        <div class="similar-grid">
          {similar.map((s) => (
            <a href={`/${s.slug}/`} class="similar-card">
              <span class="similar-name">{s.name}</span>
              <span class="similar-desc">{s.description}</span>
            </a>
          ))}
        </div>
        <Shuffle limit={4} />
      </section>
    )}

    <section class="detail-section">
      <div class="detail-section-head">
        <h2 class="h2" id="faq-heading">FAQ</h2>
      </div>
      <FaqItems faqs={faqs} />
    </section>

    {officialSite && (
      <section class="official-link-row">
        <a class="btn btn-primary btn-official" href={officialSite} target="_blank" rel="nofollow sponsored noopener noreferrer">
          Visit the official {tool.name} website
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
        </a>
        <p class="caption" style="margin-top: var(--space-sm);">
          Opens {new URL(officialSite).hostname} in a new tab.
          {slug === "codacy"
            ? " Review Radar is affiliated with Codacy."
            : ` Review Radar is not affiliated with ${tool.vendor}.`}
        </p>
      </section>
    )}
</DocsLayout>
