---
import DocsLayout from "../../layouts/DocsLayout.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import LookFor from "../../components/LookFor.astro";
import Shuffle from "../../components/Shuffle.astro";
import { EXPLORE_ARTICLES, getExploreArticle, rankToolsForArticle } from "../../data/explore.js";
import { logoPathFor } from "../../lib/logos.js";
import { attachComments, lookForFaq, SHUFFLE_NOTE } from "../../lib/picks.js";
import { faqJsonLd } from "../../lib/faq.js";
import FaqItems from "../../components/FaqItems.astro";
import { getTools } from "../../lib/tools.js";
import { AUTHOR } from "../../data/author.js";

export function getStaticPaths() {
  return EXPLORE_ARTICLES.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = getExploreArticle(slug);
const allTools = getTools();
// Server order is alphabetical (full support first); the grid is shuffled on
// every page load. Comments come from the article's picks where written.
const ranked = attachComments(rankToolsForArticle(article, allTools), article.picks, article.slug);
const alphabetical = [...ranked].sort((a, b) => a.name.localeCompare(b.name)).map((t) => ({ text: t.name, href: `/${t.slug}/` }));
const fullCount = ranked.filter((t) => !t.partial).length;
const partialCount = ranked.length - fullCount;

const headline = `Top ${ranked.length} Code Review Tools for ${article.provider} in 2026`;
const description = `${ranked.length} of ${allTools.length} tools tracked in this directory integrate with ${article.provider}. ${article.short}`;

const PARITY_CAVEAT =
  "Support is not the same as parity, since some integrations are narrower in scope or gated to a higher plan tier. Tools with full support are listed before those with partial support.";

const other = EXPLORE_ARTICLES.filter((a) => a.slug !== article.slug).slice(0, 6);
const anOrA = /^[aeiou]/i.test(article.provider) ? "an" : "a";

const faqs = [
  {
    q: `What are the best code review tools for ${article.provider}?`,
    a: ranked.length
      ? [
          `${ranked.length} of the ${allTools.length} tools in this directory document a ${article.provider} integration:`,
          { links: alphabetical },
          "Which fits best depends on your setup. The guidance on this page covers what to weigh.",
        ]
      : `None of the ${allTools.length} tools tracked in this directory document an integration with ${article.provider}.`,
  },
  {
    q: `How many tools integrate with ${article.provider}?`,
    a: [
      `${ranked.length} of ${allTools.length} tools support ${article.provider}` +
        (partialCount ? `, ${fullCount} fully and ${partialCount} partially.` : "."),
      PARITY_CAVEAT,
    ],
  },
  {
    q: `What should you look for in ${anOrA} ${article.provider} code review tool?`,
    a: lookForFaq(article.lookFor),
  },
];

const toc = [
  { id: "look-for-heading", label: "What to look for" },
  { id: "tools-heading", label: ranked.length === 1 ? "Top tool" : "Top tools" },
  ...(other.length > 0 ? [{ id: "other-heading", label: "Other platforms" }] : []),
  { id: "faq-heading", label: "FAQ" },
];

const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline,
  description,
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.linkedin },
  about: { "@type": "Thing", name: article.provider },
};
const jsonLdItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: headline,
  itemListElement: ranked.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.name,
    url: new URL(`/${t.slug}/`, Astro.site).href,
  })),
};
const jsonLdFaq = faqJsonLd(faqs, Astro.site);
---
<DocsLayout
  title={`${headline} — Review Radar`}
  description={description}
  breadcrumbs={[
    { name: "Explore", url: "/explore/" },
    { name: `Top ${article.provider} Tools`, url: `/explore/${article.slug}/` },
  ]}
  nav="explore"
  current={article.slug}
  toc={toc}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

    <article>
      <header class="article-head">
        <p class="label section-label">{article.group}</p>
        <h1 class="h1">{headline}</h1>
        <p class="article-lede">{article.short}</p>
      </header>

      <section class="article-section">
        {article.intro.map((p) => <p class="article-body">{p}</p>)}
      </section>

      <LookFor items={article.lookFor} />

      <section class="article-section">
        <h2 class="h3" id="tools-heading">
          Top {ranked.length} code review {ranked.length === 1 ? "tool" : "tools"} for {article.provider}
        </h2>
        <p class="text-secondary body-sm" style="margin-top: var(--space-xs);">
          Every tool in the directory documented as integrating with {article.provider}
          {partialCount > 0 && <>, {fullCount} fully, {partialCount} partially</>}.
          {` ${SHUFFLE_NOTE}`}
        </p>
        {partialCount > 0 && <p class="caption parity-caveat">{PARITY_CAVEAT}</p>}
        <div class="tool-grid pick-grid">
          {ranked.map((t) => (
            <a href={`/${t.slug}/`} class="tool-card" data-band={t.partial ? "partial" : "full"}>
              <div class="tool-card-head">
                <p class="tool-category-label">{t.categoryLabel}</p>
                <div class="tool-name-row">
                  <span class="tool-avatar">
                    {logoPathFor(t.slug) ? <img src={logoPathFor(t.slug)} alt="" loading="lazy" /> : t.initial}
                  </span>
                  <span class="tool-name">{t.name}</span>
                  {t.partial && <span class="facet-status status-partial">Partial</span>}
                </div>
              </div>
              <p class="tool-desc is-full">{t.comment ?? t.description}</p>
              <div class="tool-footer">
                <span class="tool-price">{t.priceLabel}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
              </div>
            </a>
          ))}
        </div>
        <Shuffle />
      </section>

      {other.length > 0 && (
        <section class="article-section">
          <h2 class="h3" id="other-heading">Other platforms</h2>
          <div class="chip-list" style="margin-top: var(--space-md);">
            {other.map((a) => (
              <a href={`/explore/${a.slug}/`} class="chip chip-link">{a.provider}</a>
            ))}
          </div>
        </section>
      )}

      <section class="article-section">
        <h2 class="h3" id="faq-heading">FAQ</h2>
        <FaqItems faqs={faqs} />
      </section>

      <AuthorCard />
    </article>
</DocsLayout>
