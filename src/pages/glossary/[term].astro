---
import DocsLayout from "../../layouts/DocsLayout.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import LookFor from "../../components/LookFor.astro";
import Shuffle from "../../components/Shuffle.astro";
import {
  GLOSSARY,
  getGlossaryTerm,
  toolsForTerm,
  facetCellFor,
  valueForTerm,
  GLOSSARY_PUBLISHED,
  GLOSSARY_UPDATED,
} from "../../data/glossary.js";
import { getTools, getToolDetail, tierLabelFor, UMBRELLA } from "../../lib/tools.js";
import {
  questionFor,
  withPhraseFor,
  doesPhraseFor,
  pluralFor,
  singularFor,
  notSameAsFor,
  isCategoryTerm,
  toolsNounFor,
} from "../../data/glossary-phrasing.js";
import { logoPathFor } from "../../lib/logos.js";
import { attachComments, byBandThenName, lookForFaq, SHUFFLE_NOTE } from "../../lib/picks.js";
import { faqJsonLd } from "../../lib/faq.js";
import FaqItems from "../../components/FaqItems.astro";
import { AUTHOR } from "../../data/author.js";

export function getStaticPaths() {
  return GLOSSARY.map((t) => ({ params: { term: t.slug } }));
}

const { term: slug } = Astro.params;
const entry = getGlossaryTerm(slug);
const allTools = getTools();

// Every tool with the capability, each with its documented note and plan for
// it. Server order is alphabetical (full support first); the grid is shuffled
// on every page load. Comments come from the term's picks where written.
const withNotes = toolsForTerm(entry, allTools).map((t) => {
  const cell = facetCellFor(entry, getToolDetail(t.slug));
  return {
    ...t,
    note: cell?.note || t.description,
    tier: cell ? tierLabelFor(cell) : null,
    partial: valueForTerm(entry, t) === "partial",
  };
});
const ranked = attachComments(withNotes.sort(byBandThenName), entry.picks, entry.slug);
const commented = Boolean(entry.picks?.length);
const alphabetical = [...ranked].sort((a, b) => a.name.localeCompare(b.name)).map((t) => ({ text: t.name, href: `/${t.slug}/` }));

const related = GLOSSARY.filter((t) => t.group === entry.group && t.slug !== entry.slug).slice(0, 6);
const headline = questionFor(entry);
const isCategory = isCategoryTerm(entry);
const total = allTools.length;
const count = ranked.length;

// Categories hold the tools whose main job they describe; every other term is
// a capability that tools support fully or partly. The heading and FAQ say
// which, in words that fit the term, rather than dropping its bare name into
// one template. Headings keep "Best" for search intent ("Best 19 SAST tools");
// the list itself is shuffled. Where the term is not a kind of tool ("CLI"),
// the heading names the whole directory instead of "Best 19 CLI tools".
const toolsNoun = toolsNounFor(entry);
const listHeading = isCategory
  ? count === 1
    ? `The only ${singularFor(entry)} in the directory`
    : `Best ${count} ${pluralFor(entry)}`
  : toolsNoun
    ? `Best ${count} ${toolsNoun}`
    : `Best ${count} ${count === 1 ? UMBRELLA.replace(/tools$/, "tool") : UMBRELLA} ${withPhraseFor(entry)}`;
const howMany = count === total ? `All ${total} tools in this directory` : `${count} of the ${total} tools in this directory`;
const notSameAs = notSameAsFor(entry)
  .map((n) => ({ ...n, term: GLOSSARY.find((t) => t.slug === n.slug) }))
  .filter((n) => n.term);

// "Supports" spans a wide range here: a first-class implementation and one kept
// alive for existing customers both register as support. Split the count so the
// page never implies parity it cannot evidence.
const partialCount = ranked.filter((t) => t.partial).length;
const fullCount = ranked.length - partialCount;
const parityCaveat =
  "Support is not the same as parity, since some implementations are narrower in scope, gated to a higher plan tier, or maintained only for existing customers. " +
  (commented
    ? "The comment under each tool is our summary of what its own documentation describes."
    : "The note under each tool is what its own documentation describes.");

const faqs = [
  { q: headline, a: entry.short },
  isCategory
    ? {
        q: `How many ${pluralFor(entry)} does Review Radar track?`,
        a: [`Review Radar tracks ${count} ${count === 1 ? singularFor(entry) : pluralFor(entry)}${count ? ":" : "."}`, ...(count ? [{ links: alphabetical }] : [])],
      }
    : {
        q: `How many tools in the directory ${doesPhraseFor(entry)}?`,
        a: [
          `${howMany} ${doesPhraseFor(entry)}` + (partialCount ? `, ${fullCount} fully and ${partialCount} partially` : "") + (count ? ":" : "."),
          ...(count ? [{ links: alphabetical }] : []),
          parityCaveat,
        ],
      },
  {
    q: isCategory ? `What should you check when comparing ${pluralFor(entry)}?` : `What should you check when comparing tools ${withPhraseFor(entry)}?`,
    a: lookForFaq(entry.lookFor),
  },
];

const toc = [
  { id: "look-for-heading", label: "What to look for" },
  { id: "tools-heading", label: ranked.length === 1 ? "Best tool" : "Best tools" },
  ...(related.length > 0 ? [{ id: "related-heading", label: "Related terms" }] : []),
  { id: "faq-heading", label: "FAQ" },
];

const jsonLdTerm = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: entry.term,
  description: entry.short,
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: "Review Radar Glossary",
    url: new URL("/glossary/", Astro.site).href,
  },
};
const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline,
  description: entry.short,
  datePublished: entry.published ?? GLOSSARY_PUBLISHED,
  dateModified: entry.updated ?? GLOSSARY_UPDATED,
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.linkedin },
  about: { "@type": "DefinedTerm", name: entry.term },
};
const jsonLdFaq = faqJsonLd(faqs, Astro.site);
---
<DocsLayout
  title={`${headline} — Review Radar`}
  description={entry.short}
  breadcrumbs={[
    { name: "Glossary", url: "/glossary/" },
    { name: entry.term, url: `/glossary/${entry.slug}/` },
  ]}
  nav="glossary"
  current={entry.slug}
  toc={toc}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdTerm)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

    <article>
      <header class="article-head">
        <p class="label section-label">{entry.group}</p>
        <h1 class="h1">{headline}</h1>
        <p class="article-lede">{entry.short}</p>
      </header>

      <section class="article-section">
        {entry.long.map((p) => <p class="article-body">{p}</p>)}
        {notSameAs.map((n) => (
          <p class="caption parity-caveat">
            Not the same as <a href={`/glossary/${n.slug}/`}>{n.term.term}</a>: {n.text}
          </p>
        ))}
      </section>

      <LookFor items={entry.lookFor} />

      <section class="article-section">
        <h2 class="h3" id="tools-heading">{listHeading}</h2>
        <p class="text-secondary body-sm" style="margin-top: var(--space-xs);">
          {isCategory
            ? `Every tool in the directory whose main category is ${singularFor(entry)}.`
            : <>Every tool in the directory whose documentation covers this{partialCount > 0 && <>, {fullCount} fully and {partialCount} partially</>}.</>}
          {partialCount > 0 && " Full support is shown first."} {SHUFFLE_NOTE}
        </p>
        {!isCategory && <p class="caption parity-caveat">{parityCaveat}</p>}
        <div class="tool-grid pick-grid">
          {ranked.map((t) => (
            <a href={`/${t.slug}/`} class="tool-card" data-band={t.partial ? "partial" : "full"}>
              <div class="tool-card-head">
                <p class="tool-category-label">{t.categoryLabel}</p>
                <div class="tool-name-row">
                  <span class="tool-avatar">
                    {logoPathFor(t.slug) ? <img src={logoPathFor(t.slug)} alt="" loading="lazy" /> : t.initial}
                  </span>
                  <span class="tool-name">{t.name}</span>
                  {t.partial && <span class="facet-status status-partial">Partial</span>}
                </div>
                {t.tier && <div class="tool-card-badges"><span class="pill facet-tier">{t.tier}</span></div>}
              </div>
              <p class="tool-desc is-full">{t.comment ?? t.note}</p>
              <div class="tool-footer">
                <span class="tool-price">{t.priceLabel}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
              </div>
            </a>
          ))}
        </div>
        <Shuffle />
      </section>

      {related.length > 0 && (
        <section class="article-section">
          <h2 class="h3" id="related-heading">Related terms</h2>
          <div class="chip-list" style="margin-top: var(--space-md);">
            {related.map((r) => (
              <a href={`/glossary/${r.slug}/`} class="chip chip-link">{r.term}</a>
            ))}
          </div>
        </section>
      )}

      <section class="article-section">
        <h2 class="h3" id="faq-heading">FAQ</h2>
        <FaqItems faqs={faqs} />
      </section>

      <AuthorCard />
    </article>
</DocsLayout>
