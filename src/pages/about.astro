---
import Layout from "../layouts/Layout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import { getTools } from "../lib/tools.js";
import { GLOSSARY } from "../data/glossary.js";
import { AUTHOR } from "../data/author.js";
import { PUBLISHER, publisherLd } from "../data/publisher.js";

const tools = getTools().sort((a, b) => a.name.localeCompare(b.name));

// A sample of the tracked capabilities, linked to their glossary pages. Names
// come from the glossary itself, so they always match the rest of the site.
const SAMPLE_TERMS = [
  "sast", "sca", "secrets-detection", "iac-scanning", "code-smells",
  "test-coverage-tracking", "ai-code-review", "pr-inline-review", "merge-gate", "mcp-server",
];
const sampleTerms = SAMPLE_TERMS.map((slug) => GLOSSARY.find((t) => t.slug === slug)).filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: new URL("/about/", Astro.site).href,
  about: { "@type": "WebSite", name: "Review Radar", url: new URL("/", Astro.site).href },
  publisher: publisherLd(Astro.site),
};
---
<Layout
  title="About — Review Radar"
  description="How Review Radar compares code quality, security and code review tools: the same criteria for every tool, checked against each vendor's own documentation."
  breadcrumbs={[{ name: "About", url: "/about/" }]}
  measure
>
  <SimpleHeader slot="header" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="section" style="padding-top: var(--space-4xl); position: relative; overflow: hidden;">
    <div class="container container-measure">
      <p class="label section-label">About</p>
      <h1 class="h1">A directory of code quality, security and code review tools.</h1>
      <p class="body-lg text-secondary" style="margin-top: var(--space-lg);">
        Review Radar records what code quality, security and code review tools support, from static
        analysis and security scanning to AI-assisted review. Every tool is recorded against the same
        set of criteria, so they can be compared directly.
      </p>
    </div>
    <svg aria-hidden="true" width="360" height="360" viewBox="0 0 360 360" style="position:absolute; right:-90px; top:-40px; opacity:0.35; pointer-events:none;">
      <circle cx="180" cy="180" r="160" stroke="#1E2A40" stroke-width="1" fill="none"/>
      <circle cx="180" cy="180" r="115" stroke="#1E2A40" stroke-width="1" fill="none"/>
      <circle cx="180" cy="180" r="70" stroke="#4AB0B5" stroke-width="1" stroke-dasharray="3 4" fill="none"/>
      <line x1="180" y1="20" x2="180" y2="340" stroke="#141E30" stroke-width="1"/>
      <line x1="20" y1="180" x2="340" y2="180" stroke="#141E30" stroke-width="1"/>
      <circle cx="235" cy="150" r="3" fill="#6ECDD2"/>
      <circle cx="150" cy="230" r="2" fill="#4AB0B5"/>
    </svg>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container container-measure">
      <p class="label section-label">Why this exists</p>
      <h2 class="h2">Vendor documentation is difficult to compare.</h2>
      <hr class="rule-short" />
      <p class="text-secondary" style="margin-top: var(--space-md);">
        New static analysis, security scanning and AI-assisted review tools are released
        regularly. Existing ones change which capabilities are free, which require an enterprise
        plan, which languages they cover and which deployment models they support.
      </p>
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Each vendor describes its own product in its own terms, and limitations are rarely stated
        directly. Comparing two tools therefore means reading both sets of documentation in full
        and working out what has been left out.
      </p>
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Review Radar answers a narrower question: does a specific tool support a specific
        capability, and on which plan.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container container-measure">
      <p class="label section-label">What we track</p>
      <h2 class="h2">The same criteria for every tool.</h2>
      <hr class="rule-short" />
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Each tool is recorded against the same set of capabilities, so tools built for different
        purposes can still be compared where they overlap:
      </p>
      <div class="chip-list" style="margin-top: var(--space-lg);">
        {sampleTerms.map((t) => (
          <a href={`/glossary/${t.slug}/`} class="chip chip-link">{t.term}</a>
        ))}
        <a href="/glossary/" class="chip chip-link">All {GLOSSARY.length} in the glossary</a>
      </div>
      <p class="text-secondary" style="margin-top: var(--space-lg);">
        Each entry also records supported languages, integrations, deployment model (cloud,
        self-hosted, air-gapped) and the plan tier each capability requires. Whether a tool
        supports a capability, and whether it supports it on a given plan, are recorded as
        separate facts.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container container-measure">
      <p class="label section-label">How entries stay current</p>
      <h2 class="h2">Checked against the vendor's own documentation.</h2>
      <hr class="rule-short" />
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Each entry is reviewed against public sources: product documentation, pricing pages,
        changelogs and release notes. A capability is recorded as supported only where it is
        documented. Where the documentation doesn't mention it, it is recorded as not available,
        with a note saying so. The few cases where the evidence is unclear are marked unknown.
      </p>
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Entries are re-checked on a rolling basis. Every tool page shows the date its entry was
        last verified.
      </p>
      <div class="callout">
        <p class="callout-title">This doesn't replace the official documentation.</p>
        <p>
          Every entry here is a summary of what a vendor published on a particular date. Plans get
          restructured, capabilities move between tiers, and prices change without anyone
          announcing it.
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container container-measure">
      <p class="label section-label">Who it's for</p>
      <h2 class="h2">Engineers and security teams evaluating tools.</h2>
      <hr class="rule-short" />
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Engineers, security teams and platform leads shortlisting a tool during procurement, a
        migration or a compliance review. It assumes you already know roughly which capabilities
        you need and want to check which tools provide them.
      </p>
      <div style="margin-top: var(--space-xl);">
        <a href="/" class="btn btn-primary">Browse tools</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="who-publishes-it">
    <div class="container container-measure">
      <p class="label section-label">Who publishes it</p>
      <h2 class="h2">Published by {PUBLISHER.name}.</h2>
      <hr class="rule-short" />
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Review Radar is published by <a href={PUBLISHER.url}>{PUBLISHER.name}</a>. {PUBLISHER.about}, so
        tracking what every tool in this market supports is part of its day-to-day work.
      </p>
      <p class="text-secondary" style="margin-top: var(--space-md);">
        {PUBLISHER.name} is also one of the {tools.length} tools listed. The directory is built so that
        doesn't tilt it:
      </p>
      <ul class="fit-list strengths faq-list" style="margin-top: var(--space-md);">
        <li>{PUBLISHER.name} is recorded against the same criteria, from the same kind of public sources, as every other tool.</li>
        <li>Tool lists are shown in a random order on every visit, so no tool gets an advantage from its position.</li>
        <li>Corrections are welcome for any tool, {PUBLISHER.name} included.</li>
      </ul>
      <p class="text-secondary" style="margin-top: var(--space-md);">
        The directory is researched and maintained by <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a>.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <section class="section" id="submit-a-correction">
    <div class="container container-measure">
      <p class="label section-label">Corrections</p>
      <h2 class="h2">Submit a correction.</h2>
      <hr class="rule-short" />
      <p class="text-secondary" style="margin-top: var(--space-md);">
        Spotted something wrong or out of date? Tell us what should change and, if you can, where
        the vendor documents it. Every correction is checked against the vendor's own documentation
        before a listing changes.
      </p>

      <p id="correction-sent" class="form-sent">
        Thanks, your correction was sent. We'll check it against the vendor's documentation.
      </p>

      {/* Delivered by Netlify Forms. HubSpot's collected-forms capture is
          switched off so a correction never turns into a CRM contact. */}
      <form
        class="correction-form"
        name="correction"
        method="POST"
        action="/about/#correction-sent"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-hs-do-not-collect="true"
      >
        <input type="hidden" name="form-name" value="correction" />
        <input type="hidden" name="page" value="" />
        <p class="form-honeypot" hidden>
          <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="form-field">
          <label for="correction-tool">Tool <span class="form-optional">(optional)</span></label>
          <select id="correction-tool" name="tool">
            <option value="">Not about a specific tool</option>
            {tools.map((t) => <option value={t.name} data-slug={t.slug}>{t.name}</option>)}
          </select>
        </div>

        <div class="form-field">
          <label for="correction-message">What should change?</label>
          <textarea id="correction-message" name="message" rows="6" required></textarea>
        </div>

        <div class="form-field">
          <label for="correction-email">Your email</label>
          <input id="correction-email" type="email" name="email" autocomplete="email" required />
          <p class="form-hint">Only used to follow up on this correction.</p>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Send correction</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('form[name="correction"]');
  if (form) {
    const status = form.querySelector<HTMLElement>(".form-status");
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // Arriving from a tool page pre-selects that tool.
    const slug = new URLSearchParams(location.search).get("tool");
    const option = slug && form.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`);
    if (option) option.selected = true;

    // Record which page of the site the visitor came from, for context.
    const page = form.querySelector<HTMLInputElement>('input[name="page"]');
    if (page && document.referrer.startsWith(location.origin)) page.value = new URL(document.referrer).pathname;

    // Send in place. Without JavaScript the form posts normally and returns to #correction-sent.
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!status || !button) return;
      button.disabled = true;
      status.className = "form-status";
      status.textContent = "Sending…";
      try {
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(new FormData(form) as any).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        if (page) page.value = "";
        status.classList.add("is-sent");
        status.textContent = "Thanks, your correction was sent. We'll check it against the vendor's documentation.";
      } catch {
        status.classList.add("is-error");
        status.textContent = "That didn't send. Check your connection and try again.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
