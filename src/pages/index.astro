---
import Layout from "../layouts/Layout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import FilterGroup from "../components/FilterGroup.astro";
import Shuffle from "../components/Shuffle.astro";
import { getTools, getFacetOptions, DETECTION_FACETS, DETECTION_GROUPS } from "../lib/tools.js";
import { toolSearch } from "../lib/search-index.js";
import { logoPathFor } from "../lib/logos.js";
import { publisherLd } from "../data/publisher.js";

// Alphabetical on the server; the grid is shuffled on every page load.
const tools = getTools().sort((a, b) => a.name.localeCompare(b.name));
const facets = getFacetOptions(tools);
const totalCount = tools.length;
const allLanguages = facets.languages.map((o) => o.label);

function tokenStr(obj) {
  return Object.entries(obj)
    .filter(([, v]) => v)
    .map(([k]) => k)
    .join(" ");
}
function pipeStr(arr) {
  return `|${arr.join("|")}|`;
}
// Groups whose values are free text (may contain spaces) are matched via
// pipe-delimited membership; everything else is a space-separated token list.
const PIPE_GROUPS = ["languages", "certifications", "ides", "ci", "issuetrackers", "chat"];

// Every group holds independent capabilities a tool can have several of at
// once (e.g. a tool can be priced both per-seat and quote-based), so checking
// multiple values in the same group narrows the results (AND) rather than
// broadening them (OR). The two exceptions are facets that store a single
// mutually-exclusive value per tool — a tool has exactly one category and one
// price-transparency rating, so those stay OR-within-group, or picking two
// values would always produce zero matches.
const OR_WITHIN_GROUP = ["category"];

// Analysis & detection is shown as four filter groups, the same split the
// glossary and tool pages use. They share one filter key, so checking options
// across them still narrows the results together.
const groupOfDetection = Object.fromEntries(DETECTION_FACETS.map((f) => [f.key, f.group]));
const titleCase = (s) => s.replace(/\b[a-z]/g, (c) => c.toUpperCase());
const detectionGroups = DETECTION_GROUPS.map((group) => ({
  title: titleCase(group),
  options: facets.detectionTypes.filter((o) => groupOfDetection[o.key] === group),
}));

const description = `Compare ${totalCount} code quality, security and code review tools on what their vendors document. Filter by category, language, deployment, compliance and pricing.`;
const siteUrl = new URL("/", Astro.site).href;
// The site itself, and the directory as a list of every tool page. List order
// is alphabetical, the same neutral order the server renders before shuffling.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Review Radar",
    url: siteUrl,
    description,
    publisher: publisherLd(Astro.site),
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Code quality, security and code review tools",
    url: siteUrl,
    description,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: totalCount,
      itemListElement: tools.map((t, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: t.name,
        url: new URL(`/${t.slug}/`, Astro.site).href,
      })),
    },
  },
];
---
<Layout
  title="Review Radar — Code Quality, Security & Code Review Tools"
  description={description}
>
  <SimpleHeader slot="header" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero-search-wrap">
    <div class="container">
      <h1 class="directory-h1">Code quality, security and code review tools, compared on what vendors document</h1>
      <div class="hero-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" aria-label="Search tools" placeholder="Search tools, categories, languages, integrations…" autocomplete="off" />
        <kbd class="hero-search-key" aria-hidden="true">/</kbd>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="directory-layout">
        <aside class="filters-panel" id="filtersPanel">
          <button
            type="button"
            class="filters-toggle"
            id="filtersToggle"
            aria-expanded="false"
            aria-controls="filtersPanelBody"
          >
            <span class="filters-toggle-label">Filters</span>
            <span class="filters-toggle-count" id="filtersToggleCount" hidden></span>
          </button>

          <div class="filters-panel-body" id="filtersPanelBody">
          <div class="filters-panel-head">
            <h2 class="h4">Filters</h2>
            <button type="button" id="clearFilters">Clear all</button>
          </div>

          <FilterGroup title="Git Hosting Platform" groupKey="git" options={facets.gitProviders} open={true} />
          <FilterGroup title="Pricing Model" groupKey="pricingmodel" options={facets.pricingModels} open={true} />
          <FilterGroup title="Pricing & Trial" groupKey="pricingbool" options={facets.pricingBool} open={true} />
          <FilterGroup title="AI Capabilities" groupKey="ai" options={facets.aiCapabilities} open={true} />
          <FilterGroup title="Category" groupKey="category" options={facets.categories} open={false} />
          <FilterGroup title="Deployment" groupKey="deployment" options={facets.deployment} open={false} />
          <FilterGroup title="Workflow Stage" groupKey="workflow" options={facets.workflowStages} open={false} />
          {detectionGroups.map((g) => (
            <FilterGroup title={g.title} groupKey="detection" options={g.options} open={false} />
          ))}
          <FilterGroup title="Compliance & Governance" groupKey="compliance" options={facets.complianceBool} open={false} />
          <FilterGroup title="Certifications" groupKey="certifications" options={facets.certifications} searchable={true} open={false} />
          <FilterGroup title="API & CLI Access" groupKey="apicli" options={facets.apiCli} open={false} />
          <FilterGroup title="Languages" groupKey="languages" options={facets.languages} searchable={true} open={false} />
          <FilterGroup title="IDE Support" groupKey="ides" options={facets.ides} searchable={true} open={false} />
          <FilterGroup title="CI/CD System" groupKey="ci" options={facets.ciSystems} searchable={true} open={false} />
          <FilterGroup title="Issue Tracker" groupKey="issuetrackers" options={facets.issueTrackers} searchable={true} open={false} />
          <FilterGroup title="Chat & Notifications" groupKey="chat" options={facets.chatNotifications} searchable={true} open={false} />
          </div>
        </aside>

        <div>
          <div class="results-bar-wrap">
            <div class="results-bar">
              <p class="results-count" id="resultsCount">
                Showing <b id="visibleCount">{totalCount}</b> of {totalCount} tools
              </p>
              <label class="sort-control">
                Sort by
                <select id="sortSelect">
                  <option value="shuffled" selected>Shuffled</option>
                  <option value="updated">Last verified</option>
                  <option value="name-asc">Name (A–Z)</option>
                  <option value="name-desc">Name (Z–A)</option>
                </select>
              </label>
            </div>
            <p class="search-note" id="searchNote" aria-live="polite" hidden></p>
            <div class="active-filters" id="activeFilters" hidden></div>
          </div>
          <div class="tool-grid" id="toolGrid" data-pipe-groups={PIPE_GROUPS.join(" ")} data-or-groups={OR_WITHIN_GROUP.join(" ")}>
            {tools.map((t) => {
              return (
                <a
                  href={`/${t.slug}/`}
                  class="tool-card"
                  data-slug={t.slug}
                  data-category={t.category}
                  data-deployment={tokenStr(t.deployment)}
                  data-git={tokenStr(t.gitProviders)}
                  data-workflow={tokenStr(t.workflowStages)}
                  data-detection={tokenStr(t.detection)}
                  data-ai={tokenStr(t.aiCapabilities)}
                  data-compliance={tokenStr(t.complianceBool)}
                  data-apicli={tokenStr(t.apiCli)}
                  data-pricingmodel={t.pricingModels.join(" ")}
                  data-pricingbool={[
                    t.freeTier && "freeTier",
                    t.freeForOpenSource && "freeForOpenSource",
                    t.hasTrial && "hasTrial",
                  ]
                    .filter(Boolean)
                    .join(" ")}
                  data-languages={pipeStr(t.languages)}
                  data-anylang={t.anyLanguage ? "true" : undefined}
                  data-certifications={pipeStr(t.certifications)}
                  data-ides={pipeStr(t.ides)}
                  data-ci={pipeStr(t.ciSystems)}
                  data-issuetrackers={pipeStr(t.issueTrackers)}
                  data-chat={pipeStr(t.chatNotifications)}
                  data-search={toolSearch(t, allLanguages)}
                  data-name={t.name.toLowerCase()}
                  data-lastupdated={t.lastUpdated}
                >
                  <div class="tool-card-head">
                    <p class="tool-category-label">{t.categoryLabel}</p>
                    <div class="tool-name-row">
                      <span class="tool-avatar">
                        {logoPathFor(t.slug) ? <img src={logoPathFor(t.slug)} alt="" loading="lazy" /> : t.initial}
                      </span>
                      <span class="tool-name">{t.name}</span>
                    </div>
                  </div>
                  <p class="tool-desc">{t.description}</p>
                  <div class="tool-footer">
                    <span class="tool-price">{t.priceLabel}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg>
                  </div>
                </a>
              );
            })}
          </div>
          <Shuffle />
          <p class="no-results" id="noResults" hidden>No tools match these filters.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { createSearch, renderCorrection } from "../lib/search.js";

    const searchInput = document.getElementById("searchInput");
    const clearBtn = document.getElementById("clearFilters");
    const sortSelect = document.getElementById("sortSelect");
    const toolGrid = document.getElementById("toolGrid");
    const cards = Array.from(document.querySelectorAll(".tool-card"));
    // The grid was shuffled before first paint; keep that order for "Shuffled".
    const shuffledOrder = Array.from(toolGrid.children);
    const visibleCountEl = document.getElementById("visibleCount");
    const noResultsEl = document.getElementById("noResults");
    const checkboxes = Array.from(document.querySelectorAll('input[type="checkbox"][data-filter-group]'));
    const pipeGroupSet = new Set(toolGrid.dataset.pipeGroups.split(" "));
    const orWithinGroupSet = new Set(toolGrid.dataset.orGroups.split(" "));
    const searchNote = document.getElementById("searchNote");
    const searchTools = createSearch(cards.map((card) => card.dataset.search));
    const cardIndex = new Map(cards.map((card, i) => [card, i]));
    const activeFiltersEl = document.getElementById("activeFilters");
    const filtersPanel = document.getElementById("filtersPanel");
    const filtersToggle = document.getElementById("filtersToggle");
    const filtersToggleCount = document.getElementById("filtersToggleCount");

    // The toggle is only rendered on narrow viewports, where the panel starts
    // collapsed so the tool grid stays visible.
    filtersToggle?.addEventListener("click", () => {
      const open = filtersPanel.classList.toggle("is-open");
      filtersToggle.setAttribute("aria-expanded", String(open));
    });

    function renderActiveFilters() {
      const checked = checkboxes.filter((cb) => cb.checked);
      if (filtersToggleCount) {
        filtersToggleCount.textContent = String(checked.length);
        filtersToggleCount.hidden = checked.length === 0;
      }
      activeFiltersEl.innerHTML = "";
      activeFiltersEl.hidden = checked.length === 0;
      for (const cb of checked) {
        const label = cb.closest(".filter-option")?.querySelector("span")?.textContent || cb.dataset.value;
        const chip = document.createElement("span");
        chip.className = "active-filter-chip";

        const text = document.createElement("span");
        text.textContent = label;

        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.setAttribute("aria-label", `Remove filter: ${label}`);
        removeBtn.textContent = "×";
        removeBtn.addEventListener("click", () => {
          cb.checked = false;
          applyFilters();
        });

        chip.append(text, removeBtn);
        activeFiltersEl.appendChild(chip);
      }
    }

    function applySort() {
      const mode = sortSelect?.value || "shuffled";
      if (mode === "shuffled") {
        for (const card of shuffledOrder) toolGrid.appendChild(card);
        return;
      }
      const sorted = [...cards].sort((a, b) => {
        if (mode === "name-asc") return a.dataset.name.localeCompare(b.dataset.name);
        if (mode === "name-desc") return b.dataset.name.localeCompare(a.dataset.name);
        return b.dataset.lastupdated.localeCompare(a.dataset.lastupdated) || a.dataset.name.localeCompare(b.dataset.name);
      });
      for (const card of sorted) toolGrid.appendChild(card);
    }
    sortSelect?.addEventListener("change", applySort);

    function selectedByGroup() {
      const map = {};
      for (const cb of checkboxes) {
        if (!cb.checked) continue;
        const group = cb.dataset.filterGroup;
        (map[group] ||= new Set()).add(cb.dataset.value);
      }
      return map;
    }

    function cardMatchesGroup(card, group, value) {
      // A tool with no fixed language list works with any language.
      if (group === "languages" && card.dataset.anylang === "true") return true;
      const raw = card.dataset[group];
      if (raw === undefined) return false;
      return pipeGroupSet.has(group) ? raw.includes(`|${value}|`) : raw.split(" ").includes(value);
    }

    // `queryHits` is the set of card indexes the search box matched, or null
    // when the box is empty.
    function cardMatchesSelection(card, selected, queryHits, skipGroup) {
      if (queryHits && !queryHits.has(cardIndex.get(card))) return false;
      for (const [group, values] of Object.entries(selected)) {
        if (group === skipGroup) continue;
        const values_ = Array.from(values);
        const matches = orWithinGroupSet.has(group)
          ? values_.some((v) => cardMatchesGroup(card, group, v))
          : values_.every((v) => cardMatchesGroup(card, group, v));
        if (!matches) return false;
      }
      return true;
    }

    function updateFacetCounts(selected, queryHits) {
      for (const cb of checkboxes) {
        const group = cb.dataset.filterGroup;
        const value = cb.dataset.value;
        let count = 0;

        if (orWithinGroupSet.has(group)) {
          // Values in this group are alternatives, not additional
          // constraints, so show how many match this one alone — ignoring
          // whatever else is checked in the same group.
          for (const card of cards) {
            if (!cardMatchesSelection(card, selected, queryHits, group)) continue;
            if (cardMatchesGroup(card, group, value)) count++;
          }
        } else {
          // This value narrows further alongside whatever else is already
          // checked in the same group, so fold it into the existing
          // selection rather than ignoring the group.
          const candidate = { ...selected };
          candidate[group] = new Set(selected[group]);
          candidate[group].add(value);
          for (const card of cards) {
            if (cardMatchesSelection(card, candidate, queryHits, null)) count++;
          }
        }

        const countEl = cb.closest(".filter-option")?.querySelector(".filter-count");
        if (countEl) countEl.textContent = String(count);
      }
    }

    function applyFilters() {
      const selected = selectedByGroup();
      const rawQuery = searchInput?.value || "";
      const result = searchTools(rawQuery);
      const queryHits = result ? result.hits : null;
      renderCorrection(searchNote, rawQuery, result?.correction);
      let visible = 0;

      for (const card of cards) {
        const match = cardMatchesSelection(card, selected, queryHits, null);
        card.hidden = !match;
        if (match) visible++;
      }

      visibleCountEl.textContent = String(visible);
      noResultsEl.hidden = visible !== 0;
      updateFacetCounts(selected, queryHits);
      renderActiveFilters();
    }

    searchInput?.addEventListener("input", applyFilters);
    document.addEventListener("keydown", (e) => {
      if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.target.closest?.("input, textarea, select, [contenteditable]")) return;
      e.preventDefault();
      searchInput?.focus();
    });
    checkboxes.forEach((cb) => cb.addEventListener("change", applyFilters));

    // The option names are on screen, so a corrected spelling explains itself
    // here and needs no note.
    document.querySelectorAll(".js-inline-search").forEach((input) => {
      const options = Array.from(input.closest("details")?.querySelectorAll(".searchable-option") || []);
      const searchOptions = createSearch(options.map((el) => el.dataset.search));
      input.addEventListener("input", () => {
        const result = searchOptions(input.value);
        options.forEach((el, i) => {
          el.style.display = !result || result.hits.has(i) ? "flex" : "none";
        });
      });
    });

    clearBtn?.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      if (searchInput) searchInput.value = "";
      document.querySelectorAll(".js-inline-search").forEach((input) => (input.value = ""));
      document.querySelectorAll(".searchable-option").forEach((el) => (el.style.display = "flex"));
      applyFilters();
    });
  </script>
</Layout>
