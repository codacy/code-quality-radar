---
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---
{items.length > 0 && (
  <nav class="docs-toc" aria-label="On this page">
    <p class="docs-toc-title">On this page</p>
    <ul>
      {items.map((item) => (
        <li><a href={`#${item.id}`} data-toc-id={item.id}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
)}
