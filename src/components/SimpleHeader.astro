---
import Logo from "./Logo.astro";

interface Props {
  /** Add the button that opens the docs sidebar as a drawer on narrow screens. */
  menu?: boolean;
  menuLabel?: string;
  /** Tool slug to pre-select in the correction form, when the page is about one tool. */
  correctionTool?: string;
  /** Section tab to highlight. Defaults to the section the URL sits under. */
  section?: "tools" | "glossary" | "explore";
}
const { menu = false, menuLabel = "Open navigation", correctionTool, section } = Astro.props;
const correctionHref = `/about/${correctionTool ? `?tool=${encodeURIComponent(correctionTool)}` : ""}#submit-a-correction`;

const SECTIONS = [
  { key: "tools", label: "Tools", href: "/" },
  { key: "glossary", label: "Glossary", href: "/glossary/" },
  { key: "explore", label: "Explore", href: "/explore/" },
];
const { pathname } = Astro.url;
const firstSegment = pathname.split("/")[1];
const active = section ?? (firstSegment === "" ? "tools" : SECTIONS.find((s) => s.key === firstSegment)?.key);
---
<header class="site-header directory-header">
  <div class="container">
    <Logo />
    <nav class="header-nav" aria-label="Main">
      <ul>
        {SECTIONS.map((s) => (
          <li>
            <a
              href={s.href}
              class:list={{ "is-active": s.key === active }}
              aria-current={s.key === active ? (pathname === s.href ? "page" : "true") : undefined}
            >{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="header-github" href="https://github.com/codacy/code-quality-radar" target="_blank" rel="noopener noreferrer" aria-label="View source on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.75 5.48.75 11.75c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.17.69-3.83-1.34-3.83-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 5.74 0c2.19-1.48 3.15-1.17 3.15-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.66 5.34-5.2 5.62.41.36.77 1.06.77 2.14 0 1.54-.01 2.79-.01 3.17 0 .3.2.66.79.55A11.26 11.26 0 0 0 23.25 11.75C23.25 5.48 18.27.5 12 .5Z"/></svg>
        <span class="header-github-label">GitHub</span>
      </a>
      <a class="header-correction" href={correctionHref} aria-label="Submit a correction">
        <span class="header-correction-long">Submit a correction</span>
        <span class="header-correction-short">Correction</span>
      </a>
      {menu && (
        <button type="button" class="docs-menu-btn" aria-controls="docs-nav" aria-expanded="false" aria-label={menuLabel}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      )}
    </div>
  </div>
</header>
