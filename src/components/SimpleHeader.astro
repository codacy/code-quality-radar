---
import Logo from "./Logo.astro";

interface Props {
  /** Add the button that opens the docs sidebar as a drawer on narrow screens. */
  menu?: boolean;
  menuLabel?: string;
  /** Tool slug to pre-select in the correction form, when the page is about one tool. */
  correctionTool?: string;
}
const { menu = false, menuLabel = "Open navigation", correctionTool } = Astro.props;
const correctionHref = `/about/${correctionTool ? `?tool=${encodeURIComponent(correctionTool)}` : ""}#submit-a-correction`;
---
<header class="site-header directory-header">
  <div class="container" style="justify-content: flex-start;">
    <Logo />
    <slot />
    <div class="header-actions">
      <a class="header-correction" href={correctionHref} aria-label="Submit a correction">
        <span class="header-correction-long">Submit a correction</span>
        <span class="header-correction-short">Correction</span>
      </a>
      {menu && (
        <button type="button" class="docs-menu-btn" aria-controls="docs-nav" aria-expanded="false" aria-label={menuLabel}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      )}
    </div>
  </div>
</header>
