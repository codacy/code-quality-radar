---
import Logo from "./Logo.astro";
---
<footer class="site-footer">
  <!--
    Same "Hero Radar" motif as the About page hero (concentric rings, one
    dashed, plus a crosshair and two blips) — reused rather than a different
    motif from the design system, so it reads as one consistent mark rather
    than two competing graphics.
  -->
  <svg class="footer-motif" aria-hidden="true" viewBox="0 0 300 300" fill="none">
    <circle cx="150" cy="150" r="130" stroke="#1E2A40" stroke-width="1"/>
    <circle cx="150" cy="150" r="95" stroke="#1E2A40" stroke-width="1"/>
    <circle cx="150" cy="150" r="58" stroke="#4AB0B5" stroke-width="1" stroke-dasharray="3 4"/>
    <line x1="150" y1="10" x2="150" y2="290" stroke="#141E30" stroke-width="1"/>
    <line x1="10" y1="150" x2="290" y2="150" stroke="#141E30" stroke-width="1"/>
    <circle cx="196" cy="125" r="3" fill="#6ECDD2"/>
    <circle cx="125" cy="192" r="2" fill="#4AB0B5"/>
  </svg>
  <div class="container footer-top">
    <div class="footer-brand">
      <Logo />
      <p class="caption" style="margin-top: var(--space-sm);">Code quality, security &amp; review tools, tracked against public documentation. Updated on a rolling basis from vendor documentation.</p>
    </div>
    <div class="footer-nav-col">
      <ul class="footer-links">
        <li><a href="/">Tools</a></li>
        <li><a href="/glossary">Glossary</a></li>
        <li><a href="/explore">Explore</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <a class="footer-github" href="https://github.com/codacy/code-quality-radar" target="_blank" rel="noopener noreferrer" aria-label="View source on GitHub">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 .5C5.73.5.75 5.48.75 11.75c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.17.69-3.83-1.34-3.83-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 5.74 0c2.19-1.48 3.15-1.17 3.15-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.66 5.34-5.2 5.62.41.36.77 1.06.77 2.14 0 1.54-.01 2.79-.01 3.17 0 .3.2.66.79.55A11.26 11.26 0 0 0 23.25 11.75C23.25 5.48 18.27.5 12 .5Z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</footer>
